<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/applicationTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Заявление"
        android:textColor="#2F2A3A"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/applicationStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_status"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Статус"
        android:textColor="#6C4AB6"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/applicationApplicantTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Услуга"
        android:textColor="#5F5A68"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/applicationDateTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Дата"
        android:textColor="#7A7485"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/applicationCommentTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Комментарий"
        android:textColor="#7A7485"
        android:textSize="14sp" />

</LinearLayout>