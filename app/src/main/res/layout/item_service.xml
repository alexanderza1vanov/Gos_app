<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/serviceTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Название услуги"
        android:textColor="#2F2A3A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/serviceDescriptionTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Описание услуги"
        android:textColor="#5F5A68"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/serviceDocumentsTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Документы"
        android:textColor="#7A7485"
        android:textSize="14sp" />

</LinearLayout>