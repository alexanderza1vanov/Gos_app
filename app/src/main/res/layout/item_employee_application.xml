<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/employeeApplicationTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Заявление"
        android:textColor="#2F2A3A"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/employeeApplicantTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Заявитель"
        android:textColor="#5F5A68"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/employeeStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_status"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Статус"
        android:textColor="#6C4AB6"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/employeeDetailsTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Детали"
        android:textColor="#7A7485"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/inProgressButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#EEE7FF"
            android:text="В работу"
            android:textAllCaps="false"
            android:textColor="#6C4AB6"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/approveButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#4CAF50"
            android:text="Одобрить"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rejectButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#D9534F"
            android:text="Отклонить"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>